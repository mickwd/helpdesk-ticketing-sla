# Copiar a .env y ajustar. Sin .env se usa SQLite local (helpdesk.db).
DATABASE_URL=sqlite:///./helpdesk.db
# DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk

# Generar uno propio, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-este-secreto-en-produccion-32b
JWT_EXPIRE_MINUTES=480

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Clasificador TF-IDF opcional (requiere requirements-ml.txt)
ML_ENABLED=true

# Canales de notificación: log, email, webhook (separados por coma)
NOTIFIERS=log
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=mesa-de-ayuda@example.com
WEBHOOK_URL=
